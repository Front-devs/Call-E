# CALL-E Code Commander — server configuration
#
# Copy this file to .env and fill it in. .env is gitignored; this file is not,
# so never put a real key or a real phone number here.

# Production keys start with iams_live_. Read on the server only: the dev server
# attaches it to outbound requests and it never reaches browser code.
# Get one from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=iams_live_replace_me

# Optional. Seeds the on-call rota so a demo does not start with empty fields.
# Numbers must be E.164, and their destination must be in CALL-E's published
# coverage. Leave any rung blank to skip it.
CALLE_ROTA_PRIMARY_NAME=
CALLE_ROTA_PRIMARY_PHONE=
CALLE_ROTA_BACKUP_NAME=
CALLE_ROTA_BACKUP_PHONE=
CALLE_ROTA_MANAGER_NAME=
CALLE_ROTA_MANAGER_PHONE=
